o<tool_sensor> sub

; Misura la lunghezza dell'utensile caricato sul tool sensor e la scrive in
; tabella utensili, con la STESSA formula del cambio utensile M6 (python/remap.py):
;   offset = quota macchina del tocco - SENSOR_HEIGHT
; Lo zero pezzo Z NON viene toccato: va impostato dopo con il touch plate,
; che lavora con l'offset utensile attivo (G43) e resta valido anche dopo un M6.

#<max_probe> = #<_ini[TOOLSENSOR]maxprobe>
#<search_vel> = #<_ini[TOOLSENSOR]search_vel>
#<probe_vel> = #<_ini[TOOLSENSOR]probe_vel>
#<sensor_height> = #<_ini[TOOLSENSOR]sensor_height>

(print, max_probe is #<max_probe>)
(print, search vel is #<search_vel>)
(print, probe vel is #<probe_vel>)
(print, sensor height is #<sensor_height>)

o100 if [#<_current_tool> EQ 0]
  (abort, Nessun utensile caricato: impostalo con M61 Qn prima di misurarlo)
o100 endif

G21 (use metric units)
G90 (absolute distance mode)
G53 G0 Z0 (raise spindle to Z0)
G53 G0 X#<_ini[TOOLSENSOR]x> Y#<_ini[TOOLSENSOR]y>
G49 (cancel tool offset)

; Si parte da G53 Z0: la corsa non puo' superare lo spazio fino al limite negativo di Z
o110 if [#<max_probe> GT [0 - #<_ini[AXIS_Z]min_limit> - 1]]
  #<max_probe> = [0 - #<_ini[AXIS_Z]min_limit> - 1]
o110 endif

; Tastatura in coordinate assolute (#5063 = Z del tocco nel WCS attivo): se il G38.2
; fallisce la macro si interrompe senza lasciare attivo G91
; this section commented out for sim
G38.2 Z[#<_z> - #<max_probe>] F#<search_vel> (probe down)
G1 Z[#5063 + 4.0] F#<search_vel> (move up 4 mm above the touch)
G4 P0.5 (pause for 0.5 sec.)
G38.2 Z[#5063 - 2.0] F#<probe_vel> (probe down slower)

; this section used for sim, comment out otherwise
; G1 Z[#<_z> - 10] F#<search_vel>

; #5063 e' la Z del tocco nel WCS attivo (con G49, quindi senza offset utensile):
; sommando gli offset G5x e G92 si ottiene la quota macchina assoluta
#<touch_z_abs> = [#5063 + #[5203 + 20 * #5220] + #5213 * #5210]
(print, quota macchina tocco = #<touch_z_abs>)

G10 L1 P#<_current_tool> Z[#<touch_z_abs> - #<sensor_height>] (scrive l'offset in tabella)
G43 H#<_current_tool> (attiva l'offset appena misurato)
G53 G0 Z0 (move Z up to 0)
o<tool_sensor> endsub
M2
